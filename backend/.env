# Server Configuration
PORT=5000
NODE_ENV=development

# Main Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/secure_data_sharing

# Secure Database (MongoDB - Terpisah untuk Private Keys)
MONGODB_SECURE_URI=mongodb://localhost:27017/secure_keys_db

# JWT Secret
JWT_SECRET=super-secret-jwt-key-change-in-production-abc123xyz
JWT_EXPIRE=7d

# Encryption Configuration
PRIVATE_KEY_ENCRYPTION_ALGORITHM=aes-256-cbc

# CORS
CORS_ORIGIN=http://localhost:5173